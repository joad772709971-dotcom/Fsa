{
  "name": "mosaab-shop-management",
  "private": true,
  "version": "2.8.5",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist_electron android/app/build",
    "lint": "tsc --noEmit",
    "electron:build": "electron-builder --windows --x64",
    "dist:win": "electron-builder --windows --x64"
  },
  "build": {
    "appId": "com.alraqamalawwal.app",
    "productName": "الرقم الأول",
    "compression": "maximum",
    "electronLanguages": [
      "ar",
      "en-US"
    ],
    "asar": true,
    "directories": {
      "output": "dist_electron"
    },
    "publish": {
      "provider": "generic",
      "url": "https://dummy.example.com"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "public/favicon.ico",
      "artifactName": "Al-Raqam-Al-Awwal.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "الرقم الأول",
      "differentialPackage": false
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.14",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.6.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.1.14",
    "lightningcss-win32-x64-msvc": "^1.29.1"
  }
}
